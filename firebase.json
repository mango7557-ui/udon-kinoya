{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "server.mjs",
      "start.cmd",
      "package.json",
      "package-lock.json",
      "LOCAL-SETUP.md"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp4|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/company-basic/company-basic-recruit",
        "destination": "/contact/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-recruit/",
        "destination": "/contact/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-history",
        "destination": "/brand/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-history/",
        "destination": "/brand/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-introduce",
        "destination": "/noodle/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-introduce/",
        "destination": "/noodle/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-contact",
        "destination": "/franchise/cost/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-contact/",
        "destination": "/franchise/cost/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-product",
        "destination": "/menu/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-product/",
        "destination": "/menu/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-gallery",
        "destination": "/store/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-gallery/",
        "destination": "/store/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-organization",
        "destination": "/people/",
        "type": 301
      },
      {
        "source": "/company-basic/company-basic-organization/",
        "destination": "/people/",
        "type": 301
      }
    ]
  }
}
