{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "server.mjs",
      "start.cmd",
      "package.json",
      "package-lock.json",
      "LOCAL-SETUP.md"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|mp4|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/company-basic/company-basic-recruit/?$",
        "destination": "/contact/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-history/?$",
        "destination": "/brand/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-introduce/?$",
        "destination": "/noodle/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-contact/?$",
        "destination": "/franchise/cost/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-product/?$",
        "destination": "/menu/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-gallery/?$",
        "destination": "/store/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-organization/?$",
        "destination": "/people/",
        "type": 301
      },
      {
        "regex": "^/컨택트/?$",
        "destination": "/contact/",
        "type": 301
      },
      {
        "regex": "^/서울-용산구-한강로3가/?$",
        "destination": "/store/yongsan/",
        "type": 301
      },
      {
        "regex": "^/합정점-오픈했습니다/?$",
        "destination": "/store/hapjeong/",
        "type": 301
      },
      {
        "regex": "^/우동키노야마곡점/?$",
        "destination": "/store/euljiro/",
        "type": 301
      },
      {
        "regex": "^/서울시-강서구-마곡동-0111/?$",
        "destination": "/store/magok/",
        "type": 301
      },
      {
        "regex": "^/company-basic/company-basic-business/?$",
        "destination": "/news/",
        "type": 301
      }
    ]
  }
}
